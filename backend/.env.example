# ==========================================
# Configuración de Producción (Neon + Upstash + Render)
# ==========================================

# URL de conexión a PostgreSQL (Neon Serverless Postgres con SSL)
# En desarrollo local con Docker, si se omite se usará 127.0.0.1:5433 (oogle_user / oogle_pass / oogleos_db)
DATABASE_URL=postgresql://neondb_owner:npg_SYFPryo8RWa1@ep-dawn-fire-b9wj8hjb.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Conexión a Redis
REDIS_URL="rediss://default:gQAAAAAAAqXNAAIgcDEyYzY1ZTNjZjgyMDE0N2U1ODUwZmMzZDI0MjFkYWI4MQ@main-lamprey-173517.upstash.io:6379"
# URL de conexión a Redis / BullMQ (Upstash Redis con TLS usando protocolo rediss://)
# En desarrollo local con Docker, si se omite se usará 127.0.0.1:6379
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Puerto HTTP del servidor Backend (Render inyecta PORT automáticamente)
PORT=3000

# Dominio(s) permitido(s) por CORS separados por coma (ej. dominio de Cloudflare Pages)
CORS_ORIGIN=https://oogleos.pages.dev,http://localhost:5173

